# Copy the variables you need into your shell. Do not commit a real token.
# The node reads the process environment. It does not load this file.

CHAIN_HOST=127.0.0.1
CHAIN_PORT=5000
CHAIN_DIFFICULTY=4
CHAIN_DATA_DIR=data

# Required before CHAIN_HOST is anything other than loopback.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CHAIN_API_TOKEN=

# Used by python -m chain.client when you do not pass --node.
# CHAIN_NODE=http://127.0.0.1:5000
